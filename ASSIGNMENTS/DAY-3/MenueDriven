public static void methodEvaluation(){
Scanner sc = new Scanner(System.in);
System.out.print("Enter Your Marks of Maths:");
int maths = sc.nextInt();
System.out.print("Enter Your Marks of Science:");
int science =sc.nextInt();
System.out.print("Enter Your Marks of History:");
int history = sc.nextInt();

int avg;

avg= (maths+science+history)/3;
if(avg>=90){
System.out.print("You Got Grade:A");
}

else if(avg>=70){
System.out.print("You Got Grade:B");
}
else if(avg>=50){
System.out.print("You Got Grade:C");
}
else if(avg>=30){
System.out.print("You Got Grade:D");
}
else {
System.out.print("You FAIL");
}
}

public static void DaysOfWeek(){


Scanner sc = new Scanner(System.in);
System.out.print("Enter The Day Number:");
int num= sc.nextInt();
switch(num){
case 1:System.out.print("Monday");
break;
case 2:System.out.print("Tuesday");
break;
case 3:System.out.print("Wednesday");
break;
case 4:System.out.print("Thrusday");
break;
case 5:System.out.print("Friday");
break;
case 6:System.out.print("Saturday");
break;
case 7:System.out.print("Sunday");
break;
default:System.out.print("Invalid Number.");
break;


}


}


