class Grade{
	public static void main (String args[]){
	
	int math = 80;
	int science = 85;
	int history  = 90;
	
	int avg = (math + science + history)/3;

	if(avg>=90){
	System.out.print("Grade:A");
	}
	else if(avg>=70)
	{
	System.out.print("Grade:B");
	}
	else if(avg>=50)
	{
	System.out.print("Grade:C");
	}
	else if(avg>=30)
	{
	System.out.print("Grade:D");
	}
	else
	{
	System.out.print("Grade:FAIL");
	}


	
}
}
